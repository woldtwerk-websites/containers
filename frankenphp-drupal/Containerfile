FROM dunglas/frankenphp:1-php8.5

RUN install-php-extensions \
    apcu \
    bcmath \
    gd \
    opcache \
    pdo_mysql \
    pdo_pgsql \
    redis \
    zip

RUN apt-get update && apt-get install -y --no-install-recommends \
  libedit2 \
  libncurses6 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=drupal:php8.5 /usr/local/etc/php/conf.d/* /usr/local/etc/php/conf.d/
COPY --from=composer/composer:2-bin /composer /usr/local/bin/
COPY --from=mariadb:12 /usr/bin/mariadb /usr/local/bin/mysql
COPY --from=mariadb:12 /usr/bin/mariadb-dump /usr/local/bin/mysqldump
COPY --from=node:26-trixie-slim /usr/local/bin/node /usr/local/bin/
COPY --from=node:26-trixie-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV SERVER_NAME=:80

WORKDIR /www
COPY Caddyfile /etc/frankenphp/Caddyfile
COPY php.ini /usr/local/etc/php/conf.d/zz-drupal.ini
RUN set -eux; \
    rm -rf /app/public

ENV PATH=${PATH}:/www/current/vendor/bin
