FROM dunglas/frankenphp:1-php8.5@sha256:17ff6554ba6de527d17aa5ec37e2a3bc3b182d7dbea9362f9a02eb5b4a1c4b95

RUN install-php-extensions \
    apcu \
    bcmath \
    gd \
    opcache \
    pdo_mysql \
    pdo_pgsql \
    redis \
    zip

RUN apt-get update && apt-get install -y --no-install-recommends \
  ffmpeg \
  libedit2 \
  libncurses6 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=drupal:php8.5@sha256:ccc5601975098c765fcb87ee335dac7ec311a31804b0f8f1b99e6d673dbb3bd2 /usr/local/etc/php/conf.d/* /usr/local/etc/php/conf.d/
COPY --from=composer/composer:2-bin@sha256:4eaf89f62eb9504807f2828f1829a71b7fcd202e89abe2f41c1fb2136068fbfb /composer /usr/local/bin/
COPY --from=mariadb:12@sha256:4aaf88b3106382c8c18e49f0cec60267be618fc22f858c4503afb2a2555afed3 /usr/bin/mariadb /usr/local/bin/mysql
COPY --from=mariadb:12@sha256:4aaf88b3106382c8c18e49f0cec60267be618fc22f858c4503afb2a2555afed3 /usr/bin/mariadb-dump /usr/local/bin/mysqldump
COPY --from=node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc /usr/local/bin/node /usr/local/bin/
COPY --from=node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV SERVER_NAME=:80

WORKDIR /www
COPY Caddyfile /etc/frankenphp/Caddyfile
COPY php.ini /usr/local/etc/php/conf.d/zz-drupal.ini
RUN set -eux; \
    rm -rf /app/public

ENV PATH=${PATH}:/www/current/vendor/bin
