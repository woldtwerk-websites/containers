FROM dunglas/frankenphp:1-php8.5@sha256:c8abcc7925f16b1431f139d0410abe8f48db3fd862bacb646b05a4413337106a

RUN install-php-extensions \
    apcu \
    bcmath \
    gd \
    opcache \
    pdo_mysql \
    pdo_pgsql \
    redis \
    zip

RUN apt-get update && apt-get install -y --no-install-recommends \
  libedit2 \
  libncurses6 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=drupal:php8.5@sha256:45038cb0a815fad7d62f05d3a43fcadb0c7337ee8c8c4c82ed050cf89b5b7294 /usr/local/etc/php/conf.d/* /usr/local/etc/php/conf.d/
COPY --from=composer/composer:2-bin@sha256:016c41066558559142758092f7ef286d66ae113df23d49e086fdda0166dd5f01 /composer /usr/local/bin/
COPY --from=mariadb:12@sha256:d46e102fa8b9b72bfcdeb56f9dd538742092119dc8b11f31fe662605cd234cd9 /usr/bin/mariadb /usr/local/bin/mysql
COPY --from=mariadb:12@sha256:d46e102fa8b9b72bfcdeb56f9dd538742092119dc8b11f31fe662605cd234cd9 /usr/bin/mariadb-dump /usr/local/bin/mysqldump
COPY --from=node:26-trixie-slim /usr/local/bin/node /usr/local/bin/
COPY --from=node:26-trixie-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV SERVER_NAME=:80

WORKDIR /www
COPY Caddyfile /etc/frankenphp/Caddyfile
COPY php.ini /usr/local/etc/php/conf.d/zz-drupal.ini
RUN set -eux; \
    rm -rf /app/public

ENV PATH=${PATH}:/www/current/vendor/bin
