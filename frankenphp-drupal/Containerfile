FROM dunglas/frankenphp:1-php8.5@sha256:667c5fffd348d9c3c260803d75956f1d9aace7e4b7331d8893de6f101d7e0e57

RUN install-php-extensions \
    apcu \
    bcmath \
    gd \
    opcache \
    pdo_mysql \
    pdo_pgsql \
    redis \
    zip

RUN apt-get update && apt-get install -y --no-install-recommends \
  ffmpeg \
  libedit2 \
  libncurses6 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=drupal:php8.5@sha256:45038cb0a815fad7d62f05d3a43fcadb0c7337ee8c8c4c82ed050cf89b5b7294 /usr/local/etc/php/conf.d/* /usr/local/etc/php/conf.d/
COPY --from=composer/composer:2-bin@sha256:269d47ef954e254227bccb35e3e40f642756abee44dded405e1fbb6f5e52af0c /composer /usr/local/bin/
COPY --from=mariadb:12@sha256:4ebbcf100a3ba320766dfa0e1af008df12261301db6ef72798c7650f70794aed /usr/bin/mariadb /usr/local/bin/mysql
COPY --from=mariadb:12@sha256:4ebbcf100a3ba320766dfa0e1af008df12261301db6ef72798c7650f70794aed /usr/bin/mariadb-dump /usr/local/bin/mysqldump
COPY --from=node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 /usr/local/bin/node /usr/local/bin/
COPY --from=node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV SERVER_NAME=:80

WORKDIR /www
COPY Caddyfile /etc/frankenphp/Caddyfile
COPY php.ini /usr/local/etc/php/conf.d/zz-drupal.ini
RUN set -eux; \
    rm -rf /app/public

ENV PATH=${PATH}:/www/current/vendor/bin
